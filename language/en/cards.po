msgid "顺走"
msgstr "顺走"

msgid "选择一张对方手中的卡牌加入手中，忽略双方反制卡，装备，特性，标记的效果"
msgstr "Choose a card from your opponent's hand and add it to your hand,ignoring the effects of counter-cards/equips/traits/tags on both sides"

msgid "打击"
msgstr "Attack(lv.1)"

msgid "猛击"
msgstr "Attack(lv.2)"

msgid "沉思"
msgstr "Muse"

msgid "获得2MP"
msgstr "gain 2MP"

msgid "毒雾"
msgstr "Gas"

msgid "对方获得3中毒"
msgstr "your opponent gain 3 poisoned"

msgid "猛毒雾"
